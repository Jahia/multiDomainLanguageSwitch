<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.0.0</version>
    </parent>

    <groupId>org.example.modules</groupId>
    <artifactId>multi-domain-language-switch</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <name>Multi Domain Language Switch</name>
    <description>
        Language switch menu component that maps each site language to a dedicated
        base URL (hostname). Switching language keeps the current page path but
        targets the host configured for that language.
    </description>

    <properties>
        <jahia-depends>default</jahia-depends>
    </properties>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Jahia-Module-Type>module</Jahia-Module-Type>
                        <Jahia-Static-Resources>/css,/javascript</Jahia-Static-Resources>
                        <!-- Deploy-free coding: remove for production releases -->
                        <Jahia-Source-Folders>${project.basedir}</Jahia-Source-Folders>
                        <_dsannotations>*</_dsannotations>
                        <!-- Required so lsm:switchToLanguageUrlLink is visible to modules that depend on this one via jahia-depends. Jahia-Depends alone only orders the module dependency; OSGi still requires an explicit Export-Package on this side and a matching Import-Package on the consumer side. -->
                        <Export-Package>org.example.modules.lsm.taglibs</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
