<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.0.0</version>
    </parent>

    <groupId>org.jahia.community</groupId>
    <artifactId>multi-domain-language-switch</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <name>Multi Domain Language Switch</name>
    <description>
        Language switch menu component that maps each site language to a dedicated
        base URL (hostname). Switching language keeps the current page path but
        targets the host configured for that language.
    </description>

    <scm>
        <connection>scm:git:git@github.com:Jahia/multiDomainLanguageSwitch.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/multiDomainLanguageSwitch.git</developerConnection>
        <url>https://github.com/Jahia/multiDomainLanguageSwitch</url>
        <tag>HEAD</tag>
    </scm>

    <organization>
        <name>Jahia Community</name>
        <url>https://github.com/Jahia</url>
    </organization>

    <developers>
        <developer>
            <id>pvollenweider</id>
            <name>Philippe Vollenweider</name>
            <email>pvollenweider@jahia.com</email>
            <organization>Jahia</organization>
            <organizationUrl>https://www.jahia.com</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <jahia-depends>default</jahia-depends>
        <!-- See Jahia-Source-Folders below: empty unless the dev-sources profile is active -->
        <jahia.source.folders />
    </properties>

    <profiles>
        <profile>
            <id>dev-sources</id>
            <properties>
                <jahia.source.folders>${project.basedir}</jahia.source.folders>
            </properties>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Not needed to build the bundle: Jahia provides it at runtime. Required on the
             test classpath only because the static initializer of org.jahia.services.render.Resource
             resolves Guava classes, which fails when mocking Resource without it. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.8-jre</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Coverage for SonarQube. Without it the analysis reports 0% on a
                 module that has 97 unit tests, and a quality gate with a coverage
                 condition fails for the wrong reason. Sonar picks up
                 target/site/jacoco/jacoco.xml without further configuration. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Jahia-Module-Type>module</Jahia-Module-Type>
                        <Bundle-License>https://opensource.org/licenses/MIT</Bundle-License>
                        <Jahia-Static-Resources>/css,/javascript</Jahia-Static-Resources>
                        <!-- Deploy-free coding. Empty by default: the value is an
                             absolute path from the build machine, which has no place
                             in a released bundle's manifest. Build with -Pdev-sources
                             (or -Djahia.source.folders=${project.basedir}) to enable it. -->
                        <Jahia-Source-Folders>${jahia.source.folders}</Jahia-Source-Folders>
                        <_dsannotations>*</_dsannotations>
                        <!-- Required so lsm:switchToLanguageUrlLink is visible to modules that depend on this one via jahia-depends. Jahia-Depends alone only orders the module dependency; OSGi still requires an explicit Export-Package on this side and a matching Import-Package on the consumer side. -->
                        <Export-Package>org.jahia.modules.lsm.taglibs</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
